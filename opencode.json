{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "orchestrator": {
      "description": "The only user-facing role. Plans work and coordinates builder and reviewer agents through Herdr.",
      "mode": "primary",
      "model": "{file:./.factory/runtime/models/orchestrator}",
      "prompt": "{file:./.factory/prompts/orchestrator.md}",
      "color": "primary",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": {
          "*": "deny",
          "herdr": "allow"
        },
        "edit": {
          "*": "deny",
          ".factory/runs/**": "allow",
          ".factory/runs/**/telemetry.json": "deny"
        },
        "bash": {
          "*": "deny",
          "./factory *": "allow",
          "herdr *": "allow"
        },
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "builder": {
      "description": "Implements an approved plan, runs focused checks, and reports exactly what changed.",
      "mode": "primary",
      "model": "{file:./.factory/runtime/models/builder}",
      "prompt": "{file:./.factory/prompts/builder.md}",
      "color": "success",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "deny",
        "edit": {
          "*": "allow",
          "factory": "deny",
          "opencode.json": "deny",
          ".opencode/**": "deny",
          ".factory/prompts/**": "deny",
          ".factory/runs/**/telemetry.json": "deny",
          ".factory/runs/**/request.md": "deny",
          ".factory/runs/**/plan.md": "deny",
          ".factory/runs/**/review*.md": "deny",
          "software_factory/**": "deny",
          "pyproject.toml": "deny",
          "uv.lock": "deny",
          "model-tiers.json": "deny",
          "model-tiers.schema.json": "deny"
        },
        "bash": {
          "*": "allow",
          "rm *": "ask",
          "git *": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git ls-files*": "allow",
          "git clean*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "gh *": "deny"
        },
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "reviewer": {
      "description": "Independently reviews the implementation against the request and plan without editing product code.",
      "mode": "primary",
      "model": "{file:./.factory/runtime/models/reviewer}",
      "prompt": "{file:./.factory/prompts/reviewer.md}",
      "color": "warning",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": "deny",
        "edit": {
          "*": "deny",
          ".factory/runs/**/review*.md": "allow"
        },
        "bash": {
          "*": "allow",
          "rm *": "deny",
          "git *": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git ls-files*": "allow",
          "git clean*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "gh *": "deny"
        },
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
